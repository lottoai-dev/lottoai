{
  "expo": {
    "name": "LottoAI",
    "slug": "luckypick",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/LottoAI-AppStore-1024.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "LottoAI, Türkiye'nin sayısal loto oyunları için kolon üretme, çekiliş sonucu takibi ve istatistik uygulamasıdır. Çılgın Sayısal Loto, Süper Loto, Şans Topu ve On Numara. 18 yaş ve üzeri içindir. Şans oyunları bağımlılık yapabilir, sorumlu oynayın.",
    "primaryColor": "#1C9E73",
    "ios": {
      "supportsTablet": false,
      "requireFullScreen": true,
      "bundleIdentifier": "app.getlottoai.ios",
      "icon": "./assets/images/LottoAI-iOS-180.png",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Çekiliş saatlerinde hatırlatıcı bildirimi almak için izin gereklidir.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleLocalizations": ["tr", "en"]
      },
      "splash": {
        "backgroundColor": "#0A0C10"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#1C9E73",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "app.getlottoai.android",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ],
      "jsEngine": "hermes"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/LottoAI-favicon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0C10",
          "image": "./assets/images/splash-icon-dark.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-notification-icon.png",
          "color": "#1C9E73",
          "sounds": []
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.775120851198-e7vqla2tctm62lkccaiqtcir6sbm4ter"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6473293791186582~4038773731",
          "iosAppId": "ca-app-pub-6473293791186582~6686024934"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withAndroidPhoneOnly"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "1686d4a1-7dbf-4293-a0b3-a71afc9e4a61"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "lottoai",
    "owner": "luckypick"
  }
}